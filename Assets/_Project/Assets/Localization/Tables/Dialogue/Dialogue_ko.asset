  - m_Id: 57814286336
    m_Localized: "<speed=60>\uC5B4\uC11C \uC624\uAC8C, \uC190\uB2D8!</speed> \uC774 \uB0A1\uC740 \uC11C\uCEE4\uC2A4 \uADF9\uC7A5\uC5D0 <bold>\uC624\uC2E0 \uAC78 \uD658\uC601\uD558\uB124.</bold>"
    m_Metadata:
      m_Items: []
  - m_Id: 57826869248
    m_Localized: "<shake a=6 s=40>\uC870\uC2EC\uD558\uAC8C!</shake> \uC774 \uBB34\uB300 \uC544\uB798\uC5D0\uB294 \uBB34\uC5B8\uAC00 <wave>\uAFC8\uD2C0\uAC70\uB9AC\uACE0</wave> \uC788\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 57843646464
